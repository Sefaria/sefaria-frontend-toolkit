{
  "name": "sefaria-frontend-toolkit-workspace",
  "version": "0.0.2",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build && node scripts/build-script-source.mjs --packages",
    "build:site": "node scripts/build-site.mjs",
    "build:site:bundles": "node scripts/build-site.mjs --skip-typecheck",
    "build:script-source": "node scripts/build-script-source.mjs",
    "test:script-source": "node scripts/test-script-source.mjs",
    "build:mcp": "pnpm --filter @sefaria-example/mcp-app build",
    "check": "node scripts/check.mjs",
    "check:site": "node scripts/check.mjs --site",
    "check:site:fast": "node scripts/check-site-fast.mjs",
    "check:api-docs": "node scripts/check-api-docs.mjs",
    "client:fixture:capture-candidate": "pnpm --filter @sefaria/api-client fixture:capture-candidate",
    "capture:mcp:vscode": "pnpm build:mcp && tsx examples/mcp-app/scripts/capture-vscode-host.ts --capture",
    "changeset:rehearse": "node scripts/rehearse-changesets.mjs",
    "compatibility:qualify": "pnpm --filter @sefaria-tests/compatibility qualify",
    "dev": "pnpm build && vite . --open /examples/explorer/",
    "dev:site": "pnpm site:examples && vitepress dev docs --host 127.0.0.1",
    "dev:bilingual-segment": "pnpm build && vite . --open /examples/explorer/bilingual-segment.html",
    "dev:connections": "pnpm build && vite . --open /examples/explorer/connections.html",
    "dev:linked-article": "pnpm --filter @sefaria-example/linked-article dev",
    "dev:source-card": "pnpm build && vite . --open /examples/explorer/source-card.html",
    "dev:mcp": "pnpm --filter @sefaria-example/mcp-app dev",
    "dev:reader": "pnpm --filter @sefaria-example/reader dev",
    "dev:alpine": "pnpm --filter @sefaria-example/alpine-vite dev",
    "dev:react": "pnpm --filter @sefaria-example/react-vite dev",
    "dev:vanilla": "pnpm --filter @sefaria-example/vanilla-vite dev",
    "dev:text-segment": "pnpm build && vite . --open /examples/explorer/text-segment.html",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "integration:check": "node scripts/check-integration-policy.mjs && node scripts/check-test-disposition.mjs",
    "lint": "oxlint --config .oxlintrc.json .",
    "metadata:check": "node scripts/generate-package-metadata.mjs --check",
    "metadata:generate": "node scripts/generate-package-metadata.mjs",
    "package:smoke": "node scripts/test-tarball-consumer.mjs && node scripts/qualify-npm-release.mjs",
    "release:prepare": "node scripts/npm-release.mjs prepare",
    "release:verify": "node scripts/npm-release.mjs verify",
    "release:verify-cdn": "node scripts/verify-npm-cdn.mjs",
    "release:version:initial": "node scripts/prepare-npm-version.mjs initial",
    "postinstall": "node scripts/normalize-lockfile.mjs",
    "openapi:check": "pnpm --filter @sefaria/api-client openapi:check",
    "openapi:drift": "pnpm --filter @sefaria/api-client openapi:drift",
    "openapi:generate": "pnpm --filter @sefaria/api-client openapi:generate",
    "openapi:refresh": "pnpm --filter @sefaria/api-client openapi:refresh",
    "preview:site": "node scripts/site-preview-server.mjs",
    "prose:check": "node scripts/check-prose.mjs",
    "site:examples": "node scripts/build-site.mjs --examples-only",
    "setup:agent": "node scripts/setup-agent.mjs",
    "setup:mcp:vscode": "pnpm build:mcp && tsx examples/mcp-app/scripts/setup-vscode-host.ts",
    "launch:mcp:vscode": "pnpm build:mcp && tsx examples/mcp-app/scripts/launch-vscode-host.ts",
    "walkthrough:mcp:vscode": "pnpm build:mcp && tsx examples/mcp-app/scripts/capture-vscode-host.ts",
    "test": "vitest run",
    "test:site": "node scripts/test-site.mjs",
    "test:site:live": "pnpm build:site && node scripts/test-site-live.mjs",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck && tsc -p demos/tsconfig.json && node scripts/check-documentation-snippets.mjs",
    "reference:generate": "tsx scripts/reference/generate.ts",
    "reference:check": "tsx scripts/reference/generate.ts --check"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.2",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@octokit/rest": "22.0.1",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "^4.1.10",
    "mermaid": "^12.0.0",
    "oxc-parser": "0.147.0",
    "oxlint": "1.80.0",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "tar": "7.5.22",
    "ts-blank-space": "^0.9.0",
    "tsx": "^4.23.12",
    "typescript": "7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-singlefile": "^2.3.3",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "^2.0.17",
    "vitest": "^4.1.10",
    "vitest-browser-lit": "^1.0.1",
    "yaml": "2.9.0",
    "zod": "4.4.3"
  }
}
