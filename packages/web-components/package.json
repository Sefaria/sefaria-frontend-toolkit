{
  "name": "@sefaria/web-components",
  "version": "0.1.1-alpha.0",
  "description": "Declarative Sefaria web components backed by corrected client payloads and safe text transforms.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sefaria/sefaria-frontend-toolkit.git",
    "directory": "packages/web-components"
  },
  "homepage": "https://github.com/Sefaria/sefaria-frontend-toolkit#readme",
  "files": [
    "dist",
    "!dist/*.tsbuildinfo",
    "README.md",
    "custom-elements.json"
  ],
  "customElements": "./custom-elements.json",
  "sideEffects": [
    "./dist/index.js",
    "./dist/*-element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./data-source": {
      "types": "./dist/data-source.d.ts",
      "import": "./dist/data-source.js"
    },
    "./bilingual-segment": {
      "types": "./dist/bilingual-segment-public.d.ts",
      "import": "./dist/bilingual-segment-public.js"
    },
    "./connections-panel": {
      "types": "./dist/connections-panel-public.d.ts",
      "import": "./dist/connections-panel-public.js"
    },
    "./reader": {
      "types": "./dist/reader-public.d.ts",
      "import": "./dist/reader-public.js"
    },
    "./reader-session": {
      "types": "./dist/reader-session-public.d.ts",
      "import": "./dist/reader-session-public.js"
    },
    "./source-card": {
      "types": "./dist/source-card-public.d.ts",
      "import": "./dist/source-card-public.js"
    },
    "./text-segment": {
      "types": "./dist/text-segment-public.d.ts",
      "import": "./dist/text-segment-public.js"
    }
  },
  "dependencies": {
    "@sefaria/api-client": "workspace:*",
    "@sefaria/text-transform": "workspace:*",
    "lit": "^3.3.3"
  },
  "scripts": {
    "build": "node ../../scripts/clean-package-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  }
}
